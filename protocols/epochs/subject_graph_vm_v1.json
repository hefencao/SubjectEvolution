    {
      "stage": 2,
      "name": "activation-routing",
      "runtime_change": "generic graph may influence bounded action potentials"
    },
    {
      "stage": 3,
      "name": "token-event-trace-then-delayed-plasticity",
      "runtime_change": "Stage 3A stores compact graph tokens and objective facts; Stage 3B-1 adds short-lived local activity eligibility; Stage 3B-2 records bootstrap delayed association candidates; Stage 3B-3 records rejectable parameter-family modulation proposals; Stage 3C-1 binds proposals to pre-activation local carriers; Stage 3C-2 emits bounded candidate deltas; Stage 3C-3 validates exact all-or-none shadow transactions; Stage 3C-4 permits explicitly opted-in short-window live writes with a bounded applied ledger and automatic rollback; Stage 3C-5 records score-free objective evidence for guarded-live and read-only control windows; Stage 3C-6 creates explicit shared-checkpoint branch identities and exports component-wise paired evidence outside the runtime; Stage 3C-7 assesses repeated paired exports for coverage, rollback/clipping integrity, count-cost matching and component-wise branch divergence without scalarization"
    },
    {
      "stage": 4,
      "name": "developmental-variation-pruning-cost",
      "runtime_change": "topology and capacities may evolve under explicit cost"
    },
    {
      "stage": 5,
      "name": "emergence-and-epoch-qualification",
      "runtime_change": "scientific studies only after health qualification"
    }
  ],
