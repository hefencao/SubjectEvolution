  "project_version": "0.121.0",
  "principle": "The runtime may prescribe a general cognitive architecture and causal phase order, but must not prescribe concrete cognitive contents, subjective valence, social concepts or role conclusions.",
  "graph_model": {
    "identity": "one-unified-node-edge-identity-space",
    "regions_are": "developmental-search-priors-not-semantic-modules",
    "initial_regions": [
      "fast-sensorimotor",
      "persistent-state",
      "delayed-association",
      "integrative-drive"
    ],
    "future_overlap": "region assignment and cross-region bandwidth may evolve; later schemas may permit soft membership"
  },
  "routing": {
    "activation_phase": "current inputs and retained state may affect current action potentials",
    "plasticity_phase": "realized objective consequences may update only future state through bounded eligibility traces",
    "shared_graph": true,
    "same_tick_self_confirmation_forbidden": true,
    "unassigned_credit_allowed": true
  },
  "objective_engine_facts": [
    "event identity and time",
    "stable participating subject identities",
    "actual action and target",
    "physical context and objective state delta",
    "graph-produced bounded continuous internal token",
    "content provenance actually read remains future work"
  ],
  "forbidden_concrete_cognition": [
    "fixed subjective valence for energy, integrity, resources, information or reproduction",
    "fixed trust, friend, enemy, betrayal, cooperation or role semantics",
    "fixed material, knowledge, protection or conflict benefit formulas",
    "group-label bonuses or conflict targeting",
    "diagnostic labels fed back into behavior"
  ],
  "costs": [
    "expressed node maintenance",
    "node execution",
    "retained state capacity and duration",
    "active edge bandwidth",
    "cross-region transport",
    "plasticity update",
    "developmental structure creation"
  ],
